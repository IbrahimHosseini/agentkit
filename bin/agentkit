#!/usr/bin/env bash
# Bash 3.2 launcher for the shared Python lifecycle.
set -u
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  d="$(cd "$(dirname "$src")" && pwd)"
  link="$(readlink "$src")"
  case "$link" in /*) src="$link" ;; *) src="$d/$link" ;; esac
done
root="$(cd "$(dirname "$src")/.." && pwd)"
case "${1:-help}" in
  auto-update|log|feedback) exec bash "$root/lib/legacy-cli.sh" "$@" ;;
  *) command -v python3 > /dev/null 2>&1 || { echo "error: python3 >= 3.9 not found" >&2; exit 1; }; exec python3 -I "$root/lib/agentkit.py" "$@" ;;
esac
